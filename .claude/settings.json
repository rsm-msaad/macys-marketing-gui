{
  "permissions": {
    "allow": [
      // File creation / editing
      "Write",
      "Edit",

      // File reading / inspection
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(which:*)",

      // Network fetches (read-only downloads)
      "Bash(curl:*)",
      "Bash(wget:*)",

      // Git — read-only / safe write (no push, reset, rebase, merge, force)
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",

      // uv — environment + package management
      "Bash(uv venv:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv tree:*)",
      "Bash(uv python:*)",
      "Bash(uv tool:*)",

      // Activate venv before `uv run` to silence global VIRTUAL_ENV mismatch warning
      "Bash(source .venv/bin/activate && uv run:*)",
      "Bash(source .venv/bin/activate)",
      "Bash(deactivate)"
    ],
    "deny": [
      // Enforce uv add for package management — never pip
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)",
      "Bash(uv pip install:*)",
      "Bash(uv pip uninstall:*)"
    ],
    "ask": [
      // File/directory deletion — always prompt
      "Bash(rm:*)",
      "Bash(rmdir:*)",

      // Remote shell / file transfer — always prompt
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",

      // Destructive git — always prompt so students can pause and think
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)"
    ],
    // Show each permission prompt instead of silently accepting edits — teaches
    // students what Claude is doing on their behalf.
    "defaultMode": "default"
  },
  "hooks": {
    // Log every student prompt into .claude/usage-log/ (instructor review)
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/usage-log.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      // Log every tool call (name + short summary; never tool results)
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/usage-log.sh"
          }
        ]
      },
      // Before every git commit: auto-stage the usage log, then scan staged files for secrets
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-stage-log.sh",
            "if": "Bash(git commit:*)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-scan.sh",
            "if": "Bash(git commit:*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      // Record when pytest was last run (project-scoped timestamp)
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/save-test-time.sh",
            "if": "Bash(pytest:*)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/save-test-time.sh",
            "if": "Bash(uv run pytest:*)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/save-test-time.sh",
            "if": "Bash(source .venv/bin/activate && uv run pytest:*)"
          }
        ]
      },
      // Auto-format Python files with ruff after Claude writes or edits them
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      // Soft reminder on Stop if Python files changed since last pytest run
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-stale-tests.sh"
          }
        ]
      },
      // Surface ruff lint findings on Stop (no-op if project has no Python yet)
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff-check.sh"
          }
        ]
      }
    ]
  }
}
