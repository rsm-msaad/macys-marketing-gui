.DS_Store
.vscode
__pycache__
*.pyc

# Project-local Claude state (keep settings.json + hooks/ tracked)
.claude/.last-test-time
.claude/settings.local.json
.claude/usage-log/.github-user
.claude/bin/

# Python / uv
.venv/
.pytest_cache/
.ruff_cache/

# Secrets
.env
.env.local
.env.*.local

# Downloaded image assets. The DAM subdir is tracked so the Render deploy
# ships with thumbnails; other subdirs (future ad hoc downloads) stay ignored.
data/images/*
!data/images/dam/

# Next.js GUI build artifacts
gui/node_modules/
gui/.next/
gui/out/
gui/.swc/

# Quarto
*_files/
*.html

# Others
Makefile
justfile
config.yaml
DEPLOY.md
vnijs-session-*

# files to exclude
/main.py
justfile
DEPLOY.md
config.yaml
__pycache__/
